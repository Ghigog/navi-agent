{
  "name": "navi",
  "version": "0.1.0",
  "private": true,
  "description": "Navi — a desktop AI companion. Electron + TypeScript port (NAV-94).",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs --watch",
    "start": "npm run build && electron .",
    "package:mac": "npm run build && electron-builder --mac dir",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "openai": "^7.10.0"
  },
  "build": {
    "appId": "com.navi.desktop",
    "productName": "Navi",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.utilities"
    }
  }
}
