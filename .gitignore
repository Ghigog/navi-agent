# Node
node_modules/
dist/

# Local scratch and test outputs
scratch/
*.wav
*.wav.import
.DS_Store
bin/.DS_Store
bin/voices/.DS_Store
.aider*

# Voice and speech models are fetched by setup_models.sh, not tracked in git. The two .onnx
# voices were also the reason .git was 116MB before NAV-81 rewrote history.
bin/ggml-base.en.bin
bin/voices/*.onnx
bin/voices/en_US-ljspeech-high.onnx.json

# Never commit run logs — the Godot SettingsManager used to print the whole settings dictionary,
# which put a live API key into a committed log (NAV-81). The rule outlived the app.
test_run.log
*.log
